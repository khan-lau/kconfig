{
  fileCache: "tmp",                 // 文件缓存目录, 中转文件临时存放路径
  syncTime: 5000,                   // 同步周期, 单位毫秒,不低于1000毫秒
  // syncFile: "conf/offset.json",     // 同步offset到文件的路径
  pointMap: "conf/pointMap.xlsx",   // 点表文件路径
  sendInterval : 1000,              // 发送频率, 单位毫秒, 默认500ms
  queueSize: 64,                    // 消息队列大小, 不超过cpu核心数的2倍

  log: {
    logLevel: -1,                   // 日志等级, (DebugLevel=-1; InfoLevel=0, WarnLevel=1; ErrorLevel=2; DPanicLevel=3; PanicLevel=4; FatalLevel=5)
    colorful: false,                // 是否需要彩色
    maxAge: 72,                     // 日志最长保留时间, 单位 小时
    maxSize: 10737418240,           // 单文件最大滚动大小, 单位 byte, 超过后强制滚动, 10G
    rotationTime: 24,               // 日志滚动周期, 单位 小时, 24小时滚动一个文件
    console: true,                  // 是否同时输出到控制台
    async: true,                    // 日志异步写入
    flushInterval: 2000,            // 异步输出日志缓冲区刷新间隔, 单位为毫秒, 默认为1s
    bufferSize: 4194304,            // 异步输出日志缓冲区大小, 单位为字节, 默认4M
    logDir: "logs",                 // 日志路径
  },

  webRPC: {
    host: "0.0.0.0",                // webRPC服务地址
    port: 10099,                    // webRPC服务端口
    reloadCooldown: 30,             // pointMap热加载冷却间隔, 单位分钟, 默认30分钟
  },

  database: [
  ],

  source: [
    {
      tag: "runtime_analog",        // 路由用标签名, 绝对不可重复 模拟量
      type: "kafkamq",              // 订阅数据源, 支持kafka rabbit rocketmq redis mqtt3 natsjs natscore消息队列
      isCompress: false,            // 是否压缩
      mq: {
        version: "3.0.0",           // kafka版本, 指定协议支持
        clientId: "sarama",
        groupId: "groupId",         // 负载均衡时使用
        brokerList: ["10.50.145.3:9092"],
        channelBufferSize: 256,     // 通道缓冲区大小
        net: {
          maxOpenRequests: 5,       // 最大请求数
          dialTimeout: 30000,       // 连接超时时长 单位ms
          readTimeout: 120000,      // 读超时时长 单位ms
          writeTimeout: 10000,      // 写超时时长 单位ms
          keepAlive: 30000,         // 心跳间隔时间, 单位ms
          resolveHost: false,       // 是否使用域名, 使用集群域名时设置为true
        },
        consumer: {
          maxProcessingTime: 5000,  // 消费者处理消息的最大时间, 超过后会触发再均衡, 默认100ms
          min: 8192,                // 每次从broker拉取的最小字节数  8k
          max: 20971520,            // 每次从broker拉取的最大字节数  20M
          fetch: 4194304,           // 每次从broker拉取的字节数数 4M
          maxWaitTime: 250,         // 拉取消息时最大等待时间, 单位ms
          initialOffset: -1,        // 消费者偏移量, -1: 从最新的消息开始消费, -2: 重新开始消费
          autoCommit: "none",       // 自动commit设置, 支持 "native": 原生自动提交; "none": 手动提交
          autoCommitInterval: 5000, // native 自动commit的情况下, 多久定时commit一次, 单位ms
          returnError: true,        // 是否返回消费错误信息
          assignor: "sticky",       // 负载均衡策略, 可选范围[sticky|roundrobin|range], 默认为range, sticky: 粘性分配策略; roundrobin: 字典轮询分配策略; range: 范围分配策略
          heartbeatInterval: 5000,  // 心跳间隔时间
          rebalanceTimeout: 45000,  // 重均衡超时时间
          sessionTimeout: 30000,    // session超时时间
          topics: [
            { topic: "analog_data", partitions: [{partition: 0, offset: -1}, {partition: 1, offset: -1}, {partition: 2, offset: -1}] },      // 模拟量数据
          ],
        },
      },
    },

    {
      tag: "runtime_discrete",      // 路由用标签名, 绝对不可重复 离散量
      type: "kafkamq",              // 订阅数据源, 支持kafka rabbit rocketmq redis mqtt3 natsjs natscore消息队列
      isCompress: false,            // 是否压缩
