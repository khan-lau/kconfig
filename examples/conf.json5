  target: [
    {
      tag: "point",                    // 使用先一标准测点格式, 推送用于下游业务的数据
      type: "kafkamq",                 // 推送目标, 支持kafka rabbit rocketmq redis mqtt3消息队列
      isCompress: true,                // 是否压缩
      mq: {
        version: "3.0.0",              // kafka版本, 指定协议支持
        clientId: "sarama",
        groupId: "groupId",            // 负载均衡时使用
        brokerList: ["10.50.145.3:9092"],
        channelBufferSize: 256,        // 通道缓冲区大小
        net: {
          maxOpenRequests: 5,          // 最大请求数
          dialTimeout: 30000,          // 连接超时时长 单位ms
          readTimeout: 120000,         // 读超时时长 单位ms
          writeTimeout: 10000,         // 写超时时长 单位ms
          keepAlive: 30000,            // 心跳间隔时间, 单位ms
          resolveHost: false,          // 是否使用域名, 使用集群域名时设置为true
        },
        producer: {
          compression: "snappy",       // 压缩方式: 默认snappy , 可选[none, gzip, snappy, lz4, zstd]
          compressionLevel: -1000,     // 压缩级别, `lz4` `snappy` 不支持level参数, gzip zstd 使用 1-9参数代表低到高压缩率
          maxMessageBytes: 1048576000, // 每条消息最大容量, 单位 字节, 1000M
          requiredAcks: "local",       // 发送确认: 默认 none, 可选[none, local, all]
          idempotent: true,            // 是否开启幂等性, 默认为false, 开启后, 消息会在 Net.MaxOpenRequests大于1时, 按顺序发送, 但性能会有小幅下降
          returnAck: true,             // 是否返回ack信息
          returnError: true,           // 是否返回错误信息
          flushMessages: 1000,         // 刷新消息数量, 每10条刷新一次
          flushFrequency: 1000,        // 刷新时间, 单位ms
          flushMaxMessages: 10000,     // 最大刷新消息数量
          retryMax: 3,                 // 重试次数: 最多重试3次
          timeout: 10000,              // 超时时间 单位ms
          topics: [
            { topic: "point", partitions: [] },  // 先一标准测点, 实时
          ],
        },
      },
    },
    {
      tag: "point_his",                // 使用先一标准测点格式, 推送用于下游业务的数据
